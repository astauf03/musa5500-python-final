    "import os\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# 1. Ensure save directory exists\n",
    "# -----------------------------------------------------\n",
    "save_dir = \"docs/assets\"\n",
    "os.makedirs(save_dir, exist_ok=True)\n",
    "save_path = os.path.join(save_dir, \"psq_radar.png\")\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# 2. Extract PSQ row + city average\n",
    "# -----------------------------------------------------\n",
    "domains = [\"mobility_score\", \"land_use_score\", \"environmental_score\", \"social_score\"]\n",
    "\n",
    "psq_row = gdf[gdf[\"Name\"] == \"PASSYUNK_SQUARE\"].iloc[0]\n",
    "psq_values = psq_row[domains].values.astype(float)\n",
    "\n",
    "city_means = gdf[domains].mean().values.astype(float)\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# 3. Radar chart setup\n",
    "# -----------------------------------------------------\n",
    "labels = [\"Mobility\", \"Land Use\", \"Environmental\", \"Social\"]\n",
    "num_vars = len(labels)\n",
    "\n",
    "# angles for radar chart (close the loop)\n",
    "angles = np.linspace(0, 2 * np.pi, num_vars, endpoint=False).tolist()\n",
    "angles += angles[:1]\n",
    "\n",
    "psq_plot = np.append(psq_values, psq_values[0])\n",
    "city_plot = np.append(city_means, city_means[0])\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# 4. Plot\n",
    "# -----------------------------------------------------\n",
    "plt.figure(figsize=(8, 8))\n",
    "ax = plt.subplot(111, polar=True)\n",
    "\n",
    "# City average\n",
    "ax.plot(angles, city_plot, linewidth=2, linestyle=\"--\", color=\"gray\", label=\"City Average\")\n",
    "ax.fill(angles, city_plot, color=\"gray\", alpha=0.15)\n",
    "\n",
    "# PSQ\n",
    "ax.plot(angles, psq_plot, linewidth=3, color=\"#40C5E3\", label=\"Passyunk Square\")\n",
    "ax.fill(angles, psq_plot, color=\"#40C5E3\", alpha=0.25)\n",
    "\n",
    "# Labels + styling\n",
    "ax.set_xticks(angles[:-1])\n",
    "ax.set_xticklabels(labels, fontsize=13)\n",
    "ax.set_ylim(0, 1)\n",
    "\n",
    "ax.set_title(\"Passyunk Square vs. City Average\\nAccessibility Domain Profile\", fontsize=16, pad=20)\n",
    "ax.legend(loc=\"upper right\", bbox_to_anchor=(1.25, 1.15))\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# 5. Save\n",
    "# -----------------------------------------------------\n",
    "plt.savefig(save_path, \"radar_psq_vs_city\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "print(\"Radar chart saved to:\", save_path)\n"
   ]
