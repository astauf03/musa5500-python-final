    "plt.title(\n",
    "    \"Citywide Distribution of Scores (Boxplots) vs. Passyunk Square (Orange Dot)\",\n",
    "    fontsize=18,\n",
    "    color=\"#FF7F50\",\n",
    "    weight=\"bold\",\n",
    "    pad=20\n",
    ")\n",
    "plt.savefig(\"ep_neighborhood_scores.png\")\n",
    "plt.t\n"
