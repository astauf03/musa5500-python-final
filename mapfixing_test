    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "\n",
    "# ----------------------------------------\n",
    "# 1. Identify EP neighborhoods\n",
    "# ----------------------------------------\n",
    "ep_names = [\"PASSYUNK_SQUARE\"]\n",
    "\n",
    "# ----------------------------------------\n",
    "# 2. Choose variables to plot\n",
    "# ----------------------------------------\n",
    "vars_to_plot = [\n",
    "    \"mobility_score\",\n",
    "    \"environmental_score\",\n",
    "    \"land_use_score\",\n",
    "    \"social_score\",\n",
    "    \"accessibility_score\"\n",
    "]\n",
    "\n",
    "# Long-format for seaborn\n",
    "df_long = gdf.melt(\n",
    "    id_vars=[\"Name\"],\n",
    "    value_vars=vars_to_plot,\n",
    "    var_name=\"Variable\",\n",
    "    value_name=\"Score\"\n",
    ")\n",
    "\n",
    "# Mark EP neighborhoods\n",
    "df_long[\"is_EP\"] = df_long[\"Name\"].isin(ep_names)\n",
    "\n",
    "# ----------------------------------------\n",
    "# 3. Plot\n",
    "# ----------------------------------------\n",
    "plt.figure(figsize=(14, 8))\n",
    "\n",
    "ax = sns.boxplot(\n",
    "    data=df_long,\n",
    "    x=\"Variable\",\n",
    "    y=\"Score\",\n",
    "    color=\"lightgray\",\n",
    "    showfliers=False  # cleaner presentation\n",
    ")\n",
    "\n",
    "# Add EP points (red)\n",
    "sns.stripplot(\n",
    "    data=df_long[df_long[\"is_EP\"]],\n",
    "    x=\"Variable\",\n",
    "    y=\"Score\",\n",
    "    hue=\"Name\",\n",
    "    palette={\"PASSYUNK_SQUARE\": \"tomato\"},\n",
    "    size=10,\n",
