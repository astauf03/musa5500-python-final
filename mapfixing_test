   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Setup output folder\n",
    "# -----------------------------------------------------\n",
    "save_dir = \"docs/assets\"\n",
    "os.makedirs(save_dir, exist_ok=True)\n",
    "save_path = os.path.join(save_dir, \"parallel_top5_ranked.png\")\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Define your domain score columns\n",
    "# -----------------------------------------------------\n",
    "domains = [\"mobility_score\", \"land_use_score\", \"environmental_score\", \"social_score\"]\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Compute rankings (descending: 1 = best)\n",
    "# -----------------------------------------------------\n",
    "gdf[\"rank\"] = gdf[\"accessibility_score\"].rank(ascending=False, method=\"dense\").astype(int)\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Extract Top 5\n",
    "# -----------------------------------------------------\n",
    "top5 = (\n",
    "    gdf[[\"NAME\", \"rank\"] + domains + [\"accessibility_score\"]]\n",
    "    .sort_values(\"rank\")\n",
    "    .head(5)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Citywide median & IQR for ribbon band\n",
    "# -----------------------------------------------------\n",
    "city_median = gdf[domains].median()\n",
    "city_q1 = gdf[domains].quantile(0.25)\n",
    "city_q3 = gdf[domains].quantile(0.75)\n",
    "\n",
    "x = np.arange(len(domains))\n",
    "\n",
    "median_vals = city_median.values\n",
    "q1_vals     = city_q1.values\n",
    "q3_vals     = city_q3.values\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Begin Plot\n",
    "# -----------------------------------------------------\n",
    "plt.figure(figsize=(12, 7))\n",
    "\n",
    "# --- Ribbon band (IQR) ---\n",
    "plt.fill_between(\n",
    "    x, q1_vals, q3_vals,\n",
    "    color=\"grey\", alpha=0.25,\n",
    "    label=\"City IQR (25–75%)\"\n",
    ")\n",
    "\n",
    "# --- Median line ---\n",
    "plt.plot(\n",
    "    x, median_vals,\n",
