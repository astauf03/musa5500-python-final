   "source": [
    "gdf_mobility= gpd.read_file(\"census/gdf_mobility.gpkg\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "dedc1419-5b71-4215-91c2-70a91324380b",
   "metadata": {},
   "outputs": [],
   "source": [
    "gdf = gdf.to_crs(epsg=4326)\n",
    "gdf_mobility = gdf_mobility.to_crs(epsg=4326)\n",
    "\n",
    "# This adds neighborhood info to each tract\n",
    "gdf_mobility_with_neighborhood = gpd.sjoin(\n",
    "    gdf_mobility,\n",
    "    gdf[[\"Name\", \"geometry\"]],  # neighborhood polygons\n",
    "    how=\"left\",\n",
    "    predicate=\"intersects\"          # tract centroid inside neighborhood polygon\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "bb791f18-6a52-42f9-975d-fdb0dfb3b9bd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Average social variables per neighborhood\n",
    "social_cols = [\"disability_rate_inv\", \"age_65_plus_rate_inv\", \"commute_walk_rate\"]\n",
    "\n",
    "gdf_social = gdf_mobility_with_neighborhood.groupby(\"Name\")[social_cols].mean().reset_index()\n"
   ]
