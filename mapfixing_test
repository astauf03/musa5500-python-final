    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Setup: ensure folder exists\n",
    "# -----------------------------------------------------\n",
    "save_dir = \"docs/assets\"\n",
    "os.makedirs(save_dir, exist_ok=True)\n",
    "save_path = os.path.join(save_dir, \"parallel_top5_vs_city_median.png\")\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Domain columns\n",
    "# -----------------------------------------------------\n",
    "domains = [\"mobility_score\", \"land_use_score\", \"environmental_score\", \"social_score\"]\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Top 5 by total accessibility_score\n",
    "# -----------------------------------------------------\n",
    "top5 = (\n",
    "    gdf[[\"Name\"] + domains + [\"accessibility_score\"]]\n",
    "    .sort_values(\"accessibility_score\", ascending=False)\n",
    "    .head(5)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Citywide medians & IQR bands\n",
    "# -----------------------------------------------------\n",
    "city_median = gdf[domains].median()\n",
    "city_q1 = gdf[domains].quantile(0.25)\n",
    "city_q3 = gdf[domains].quantile(0.75)\n",
    "\n",
    "# Convert to numpy arrays\n",
    "x = np.arange(len(domains))\n",
    "\n",
    "median_vals = city_median.values\n",
    "q1_vals = city_q1.values\n",
    "q3_vals = city_q3.values\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Plot\n",
    "# -----------------------------------------------------\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "# ---- Ribbon band: IQR ----\n",
    "plt.fill_between(\n",
    "    x,\n",
    "    q1_vals,\n",
    "    q3_vals,\n",
    "    color=\"grey\",\n",
    "    alpha=0.25,\n",
    "    label=\"City IQR (25–75%)\"\n",
    ")\n",
    "\n",
    "# ---- Median line ----\n",
    "plt.plot(\n",
    "    x, median_vals,\n",
    "    color=\"black\",\n",
    "    linewidth=3,\n",
    "    label=\"City Median\"\n",
    ")\n",
    "\n",
    "# ---- Top 5 lines ----\n",
    "colors = plt.cm.viridis(np.linspace(0.2, 0.9, len(top5)))\n",
    "\n",
    "for i, (_, row) in enumerate(top5.iterrows()):\n",
    "    label = row[\"Name\"]\n",
    "    y_vals = row[domains].values\n",
    "\n",
    "    # Highlight Passyunk Square\n",
    "    if label == \"PASSYUNK_SQUARE\":\n",
    "        plt.plot(\n",
    "            x, y_vals, linewidth=4, color=\"#40C5E3\",\n",
    "            label=\"PASSYUNK_SQUARE (highlighted)\"\n",
    "        )\n",
    "    else:\n",
    "        plt.plot(\n",
    "            x, y_vals, linewidth=2.5, color=colors[i],\n",
    "            label=label\n",
    "        )\n",
    "\n",
    "# -----------------------------------------------------\n",
    "# Styling\n",
    "# -----------------------------------------------------\n",
    "plt.xticks(x, domains, fontsize=12)\n",
    "plt.ylabel(\"Score (0–1)\", fontsize=12)\n",
    "plt.ylim(0, 1)\n",
    "\n",
    "plt.title(\"Top 5 Neighborhood Accessibility Profiles\\nvs City Median ± IQR\", fontsize=16)\n",
    "\n",
    "plt.legend(bbox_to_anchor=(1.05, 1), loc=\"upper left\")\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(save_path, dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "print(\"Saved to:\", save_path)\n"
   ]
  },
